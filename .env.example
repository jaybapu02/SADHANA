# =============================================================================
# Sadhana 2.0 – Environment Variables
# Copy this file to .env and fill in the values.  NEVER commit .env to Git.
# =============================================================================

# Django
DEBUG=False
SECRET_KEY=               # Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# Hosts & CSRF
ALLOWED_HOSTS=            # e.g. sadhana.onrender.com,sadhana.com
CSRF_TRUSTED_ORIGINS=     # e.g. https://sadhana.onrender.com,https://sadhana.com

# Database (Supabase PostgreSQL)
DATABASE_URL=             # e.g. postgresql://user:password@host:5432/dbname?sslmode=require

# Redis (for Channels / cache in production)
REDIS_URL=                # Optional - leave blank to fall back to in-memory channel layer

# Supabase (client-side / public key only)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
